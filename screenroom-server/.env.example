NODE_ENV=production
APP_BASE_PATH=/screenroom-api
PORT=3000
SITE_ORIGIN=https://screenroom.devrijonn.com
DB_HOST=localhost
DB_PORT=3306
DB_USER=devrijon_sroom
DB_PASSWORD=SET_IN_CPANEL_ENV
DB_NAME=devrijon_screenroom
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=SET_BCRYPT_HASH_IN_CPANEL_ENV
SESSION_SECRET=SET_RANDOM_64_PLUS_CHARS
TMDB_TOKEN=SET_TMDB_READ_TOKEN
R2_ACCOUNT_ID=SET_ID
R2_ACCESS_KEY_ID=SET_KEY
R2_SECRET_ACCESS_KEY=SET_SECRET
R2_BUCKET=SET_BUCKET

# Exact approved hostnames for custom CDN video URLs (comma-separated)
MEDIA_ALLOWED_HOSTS=

# Prefer ADMIN_PASSWORD_HASH_B64 in cPanel (base64-encoded full bcrypt hash).
# Base64 is transport encoding, not password encryption.
ADMIN_PASSWORD_HASH_B64=
